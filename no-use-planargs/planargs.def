Bootstrap: docker
From: nvidia/cuda:11.8.0-devel-ubuntu22.04

%files
    /tudelft.net/staff-umbrella/Deep3D/mingchiehhu/PlanarGS/requirements.txt /opt/requirements.txt
    # Copy submodules if you have them locally; otherwise git cloning in %post is often safer/easier
    /tudelft.net/staff-umbrella/Deep3D/mingchiehhu/PlanarGS/submodules/diff-plane-rasterization /opt/diff-plane-rasterization
    /tudelft.net/staff-umbrella/Deep3D/mingchiehhu/PlanarGS/submodules/simple-knn /opt/simple-knn
    /tudelft.net/staff-umbrella/Deep3D/mingchiehhu/PlanarGS/submodules/pytorch3d /opt/pytorch3d

%post
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

    # --- 1. System Setup ---
    apt-get update
    apt-get install -y --no-install-recommends wget curl git build-essential 
    apt-get install -y --no-install-recommends unzip cmake ninja-build \
        libgl1 libgl1-mesa-glx libglib2.0-0 libsm6 libxrender1 libxext6 \
        libxi6 libx11-6 libegl1-mesa-dev

    apt-get update && apt-get install -y --no-install-recommends \
        imagemagick \
        ffmpeg \
        libqt5core5a \
        libqt5gui5 \
        libqt5widgets5 \
        libqt5opengl5 \
        libqt5xml5 \
        binutils

    git config --system --add safe.directory '*'

    # Clean up apt cache to keep image small
    rm -rf /var/lib/apt/lists/*

    # --- 2. Install Miniconda ---
    CONDA_INSTALLER="Miniconda3-latest-Linux-x86_64.sh"
    wget https://repo.anaconda.com/miniconda/${CONDA_INSTALLER}
    bash ${CONDA_INSTALLER} -b -p /opt/conda
    rm ${CONDA_INSTALLER}

    export PATH="/opt/conda/bin:$PATH"
    export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6"

    # --- 3. Create Conda Environment ---
    /opt/conda/bin/conda tos accept
    /opt/conda/bin/conda create -n planargs python=3.10 -y

    # --- 4. Use Conda Environment Directly ---
    # Define the specific path to the 'bin' folder of the new env
    ENV_BIN="/opt/conda/envs/planargs/bin"
    
    # Use the conda environment's python/pip directly
    # ${ENV_BIN}/pip install cmake==3.20.*
    # ${ENV_BIN}/pip install torch==2.4.1 torchvision==0.19.1 torchaudio==2.4.1 --index-url https://download.pytorch.org/whl/cu118
    ${ENV_BIN}/pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118
    ${ENV_BIN}/pip install -r /opt/requirements.txt
    /opt/conda/bin/conda install -n planargs -y -c conda-forge "libtiff<4.5" pillow

    # --- 5. Install Submodules ---
    echo "Active Python: $(${ENV_BIN}/python --version)"
    echo "Active Pip: $(${ENV_BIN}/pip --version)"
    
    # Install ninja in the Python env (just to be safe, even if apt installed it)
    ${ENV_BIN}/pip install ninja

    echo "Installing GroundedSAM..."
    cd /opt/
    mkdir submodules/
    cd submodules/
    git clone https://github.com/IDEA-Research/Grounded-Segment-Anything.git 
    mv Grounded-Segment-Anything groundedsam
    cd groundedsam
    ${ENV_BIN}/pip install -e segment_anything

    # APPLYING THE GITHUB PATCH, omg this is insane
    cd GroundingDINO/groundingdino/models/GroundingDINO/csrc/MsDeformAttn
    echo "Patching legacy C++ code for PyTorch 2.4..."
    sed -i 's/value.type()/value.scalar_type()/g' ms_deform_attn_cuda.cu
    sed -i 's/value.scalar_type().is_cuda()/value.is_cuda()/g' ms_deform_attn_cuda.cu

    cd /opt/submodules/groundedsam/GroundingDINO
    # Explicitly pass build variables directly to the pip command
    AM_I_DOCKER=true \
    BUILD_WITH_CUDA=true \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6" \
    ${ENV_BIN}/pip install --no-build-isolation -e .

    echo "Installing diff-plane-rasterization..."
    cd /opt/diff-plane-rasterization/
    ${ENV_BIN}/pip install --no-build-isolation .

    echo "Installing simple-knn..."
    cd /opt/simple-knn/
    ${ENV_BIN}/pip install --no-build-isolation .
    
    echo "Installing Nvdiffrast..."
    ${ENV_BIN}/pip install git+https://github.com/NVlabs/nvdiffrast.git --no-build-isolation

    echo "Finalizing OpenCV installation..."
    # This ensures a clean, full install of the GUI version
    ${ENV_BIN}/pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python opencv-contrib-python-headless
    ${ENV_BIN}/pip install opencv-python-headless

    echo "Installing pytorch3d..."
    cd /opt/pytorch3d/
    ${ENV_BIN}/pip install --no-build-isolation .

    # 6. Final Cleanup
    /opt/conda/bin/conda clean --all -y
    apt-get clean && rm -rf /var/lib/apt/lists/*
    cd /

# Runtime variables
%environment
    export CUDA_HOME=/usr/local/cuda
    export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6"
    export PATH="/opt/conda/envs/planargs/bin:/opt/conda/bin:$PATH"
    export CONDA_DEFAULT_ENV="planargs"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH" 
    # Essential for GUI-based libs like OpenCV in headless HPC nodes
    export QT_QPA_PLATFORM=offscreen
    export DISPLAY=""
    export MPLBACKEND="Agg"

%runscript
    exec /bin/bash "$@"

%labels
    Author "MCHU"
    OS "Ubuntu 22.04"
    CUDA "11.8"